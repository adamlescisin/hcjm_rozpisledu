generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Venue {
  id String @id @default(uuid()) @db.Uuid
  name     String
  address  String?
  timezone String   @default("Europe/Prague")
  events   Event[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("venue")
}

model EventCategory {
  id String @id @default(uuid()) @db.Uuid
  name          String
  color         String
  icon          String?
  defaultDurationMinutes Int @default(60) @map("default_duration_minutes")

  requiresIceResurfacingBefore Boolean @default(false) @map("requires_ice_resurfacing_before")
  requiresIceResurfacingAfter  Boolean @default(false) @map("requires_ice_resurfacing_after")
  resurfacingDurationMinutes   Int     @default(15)    @map("resurfacing_duration_minutes")

  isActive Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  events     Event[]
  priceRules PriceRule[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("event_category")
}

model RecurrenceRule {
  id String @id @default(uuid()) @db.Uuid
  frequency      RecurrenceFrequency
  interval       Int      @default(1)
  daysOfWeek     Int[]    @map("days_of_week")
  untilDate      DateTime? @map("until_date")
  occurrenceCount Int?    @map("occurrence_count")
  exceptions     DateTime[] @map("exceptions")

  events Event[]

  createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("recurrence_rule")
}

model Event {
  id String @id @default(uuid()) @db.Uuid
  venueId          String  @db.Uuid @map("venue_id")
  categoryId       String  @db.Uuid @map("category_id")
  recurrenceRuleId String? @db.Uuid @map("recurrence_rule_id")
  priceRuleId      String? @db.Uuid @map("price_rule_id")

  title       String
  description String?

  startDatetime DateTime @map("start_datetime")
  endDatetime   DateTime @map("end_datetime")

  
  recurrenceIndex  Int?    @map("recurrence_index")

  status    EventStatus @default(CONFIRMED)
  createdBy String?     @map("created_by")

  // Future booking fields — not active in v1
  capacity     Int?    @map("capacity")
  isBookable   Boolean @default(false) @map("is_bookable")
  
  venue          Venue          @relation(fields: [venueId], references: [id])
  category       EventCategory  @relation(fields: [categoryId], references: [id])
  recurrenceRule RecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([venueId])
  @@index([categoryId])
  @@index([startDatetime])
  @@index([recurrenceRuleId])
  @@map("event")
}

model PriceRule {
  id String @id @default(uuid()) @db.Uuid
  categoryId String? @db.Uuid @map("category_id")
  label      String

  dayOfWeekFrom Int? @map("day_of_week_from")
  dayOfWeekTo   Int? @map("day_of_week_to")
  timeFrom      String? @map("time_from")
  timeTo        String? @map("time_to")

  priceCzk Int @map("price_czk")

  validFrom DateTime? @map("valid_from")
  validTo   DateTime? @map("valid_to")

  isActive Boolean @default(true) @map("is_active")

  category EventCategory? @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("price_rule")
}

model ThemeSettings {
  id String @id @default(uuid()) @db.Uuid
  primaryColor   String  @default("#003d80") @map("primary_color")
  secondaryColor String  @default("#c8102e") @map("secondary_color")
  accentColor    String  @default("#f5a623") @map("accent_color")
  fontHeading    String  @default("Inter") @map("font_heading")
  fontBody       String  @default("Inter") @map("font_body")
  logoUrl        String? @map("logo_url")
  scheduleWeeksAhead Int @default(4) @map("schedule_weeks_ahead")

  createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("theme_settings")
}

model AdminUser {
  id String @id @default(uuid()) @db.Uuid
  email String    @unique
  name  String?
  role  AdminRole @default(ADMIN)

  createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("admin_users")
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum EventStatus {
  CONFIRMED
  CANCELLED
  TENTATIVE
}

enum AdminRole {
  ADMIN
}
